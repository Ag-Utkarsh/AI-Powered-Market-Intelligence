"""####More Cleaning of Dataset and combining it with Rapid API dataframe

"""

import pandas as pd

googledf = pd.read_csv('cleaned_googleplaystore.csv')

rapiddf = pd.read_csv('rapidAPIdataframe.csv')

display(googledf)
display(googledf.info())

display(rapiddf)
display(rapiddf.info())

# Get the current list of columns
cols = googledf.columns.tolist()

# Assuming 'Category' was at index 1, insert 'Genres' at that position
# You might need to adjust the index based on the actual position of 'Category' before dropping
# Let's verify the original column order from the previous info() output to be sure.
# Original order: 'App', 'Category', 'Rating', 'Size', 'Installs', 'Type', 'Price($)', 'Content Rating', 'Genres', 'Current Ver', 'Android Ver', 'Reviews', 'Last Updated'
# 'Category' was at index 1.

# Find the index of 'Genres' in the current list after dropping 'Category'
genres_index = cols.index('Genres')

# Remove 'Genres' from its current position
cols.pop(genres_index)
# Insert 'Genres' at index 1 (where 'Category' used to be)
cols.insert(1, 'Genres')

# Reindex the dataframe with the new column order
googledf = googledf[cols]


print("Columns in googledf after reordering:")
display(googledf.columns)

cols = googledf.columns.tolist()

cols

cols.pop(2)

cols

googledf = googledf[cols]

googledf

googledf.info()



# Rename columns in googledf
googledf = googledf.rename(columns={'Android Ver': 'Required Version', 'Current Ver': 'Current Version', 'Size': 'Size(kb)'})

print("Columns in googledf after renaming:")
display(googledf.columns)

googledf.info()

rapiddf.info()

# Get the columns from rapiddf
rapid_cols = rapiddf.columns.tolist()

# Get the columns from googledf
google_cols = googledf.columns.tolist()

# Identify columns in googledf that are not in rapiddf
cols_to_drop = [col for col in google_cols if col not in rapid_cols]

# Drop the identified columns from googledf
googledf = googledf.drop(columns=cols_to_drop)

# Get the updated columns in googledf
updated_google_cols = googledf.columns.tolist()

# Reorder the columns in googledf to match the order in rapiddf
# Filter rapid_cols to only include columns that are still in googledf
ordered_cols = [col for col in rapid_cols if col in updated_google_cols]

googledf = googledf[ordered_cols]

print("Columns in googledf after aligning with rapiddf:")
display(googledf.columns)

display(googledf.info())
display(rapiddf.info())

googledf['Size(kb)']

def convert_size_to_kb(size):
    if pd.isna(size) or size == 'Varies with device':
        return pd.NA
    size = size.strip()
    if size.endswith('M'):
        return float(size[:-1]) * 1024
    elif size.endswith('k'):
        return float(size[:-1])
    elif size.endswith('G'):
        return float(size[:-1]) * 1024 * 1024 # Convert GB to KB
    else:
        return pd.NA # Handle any other unexpected formats

# Apply the conversion function to the 'Size(kb)' column
googledf['Size(kb)'] = googledf['Size(kb)'].apply(convert_size_to_kb)

print("Data type of the 'Size(kb)' column after conversion:")
display(googledf['Size(kb)'].dtype)
print("\nFirst 5 values in the 'Size(kb)' column after cleaning:")
display(googledf['Size(kb)'].head())
print("\nNumber of missing values in 'Size(kb)' after cleaning:")
display(googledf['Size(kb)'].isnull().sum())

# Calculate the mean of the 'Size(kb)' column, excluding missing values
mean_size_kb = googledf['Size(kb)'].mean()

# Fill missing values in 'Size(kb)' with the calculated mean
googledf['Size(kb)'] = googledf['Size(kb)'].fillna(mean_size_kb)

print("Number of missing values in 'Size(kb)' after filling with mean:")
display(googledf['Size(kb)'].isnull().sum())
print("\nFirst 5 values in the 'Size(kb)' column after filling missing values:")
display(googledf['Size(kb)'].head())

rapiddf['Rating'] = rapiddf['Rating'].astype(object)

print("Data type of the 'Rating' column in rapiddf after conversion:")
display(rapiddf['Rating'].dtype)

display(googledf.info())
display(rapiddf.info())

googledf = googledf[ordered_cols]
rapiddf = rapiddf[ordered_cols]

# Concatenate the two dataframes row-wise
combined_df_rowwise = pd.concat([googledf, rapiddf], ignore_index=True)

display(combined_df_rowwise.info())
print("\nFirst 5 rows of the combined dataframe (row-wise):")
display(combined_df_rowwise.head())
print("\nLast 5 rows of the combined dataframe (row-wise):")
display(combined_df_rowwise.tail())

# Save the combined dataframe to a CSV file
combined_df_rowwise.to_csv('combined_dataframe.csv', index=False)